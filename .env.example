MEDIAFORGE_HOST=127.0.0.1
MEDIAFORGE_PORT=8787
MEDIAFORGE_DATA_DIR=.mediaforge
MEDIAFORGE_PROJECTS_DIR=.mediaforge/projects
MEDIAFORGE_OUTPUT_DIR=.mediaforge/outputs
MEDIAFORGE_RENDERER=dry-run
MEDIAFORGE_MAX_RETRIES=2
MEDIAFORGE_POLL_MS=1500
MEDIAFORGE_WORKER_ID=windows-local
MEDIAFORGE_REQUIRE_AUTH=false
MEDIAFORGE_MCP_TOKEN=replace-with-a-long-random-token
MEDIAFORGE_SETUP_TOKEN=replace-with-a-one-time-setup-token
MEDIAFORGE_ALLOW_LOCAL_SETUP=false
MEDIAFORGE_OAUTH_ISSUER=https://mediaforge.example.com
HYPERFRAMES_BIN=npx
