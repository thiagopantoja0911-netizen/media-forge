{
  "name": "mediaforge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs --watch",
    "worker:once": "node src/worker.mjs --once",
    "validate": "node src/job-schema.mjs examples/job.json",
    "worker:remote": "node src/remote-worker-client.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "motion:compose": "node scripts/compose-motion.mjs",
    "reference:analyze": "node scripts/analyze-reference.mjs",
    "frame-lab:test": "node --test frame-lab/tests/curves.test.mjs frame-lab/tests/api.test.mjs frame-lab/tests/synthetic-node.test.mjs",
    "test:integrated": "node --test --test-concurrency=1 test/*.test.mjs frame-lab/tests/*.test.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "sharp": "0.35.5",
    "ffmpeg-static": "5.3.0",
    "@derhuerst/ffprobe-static": "5.3.0",
    "fflate": "0.8.3"
  }
}
