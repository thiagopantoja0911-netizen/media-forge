{
  "name": "mediaforge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs --watch",
    "worker:once": "node src/worker.mjs --once",
    "validate": "node src/job-schema.mjs examples/job.json",
    "worker:remote": "node src/remote-worker-client.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "motion:compose": "node scripts/compose-motion.mjs",
    "reference:analyze": "node scripts/analyze-reference.mjs",
    "frame-lab:test": "node --test frame-lab/tests/curves.test.mjs frame-lab/tests/api.test.mjs frame-lab/tests/synthetic-node.test.mjs frame-lab/tests/artistic-signals.test.mjs",
    "media-tools:install": "npm rebuild ffmpeg-static @derhuerst/ffprobe-static && node scripts/verify-media-tools.mjs && npm run remotion:prepare",
    "test:integrated": "node --test --test-concurrency=1 test/*.test.mjs frame-lab/tests/*.test.mjs",
    "remotion:build-player": "node scripts/build-remotion-player.mjs",
    "remotion:prepare": "node scripts/build-remotion-player.mjs && node scripts/prepare-remotion-assets.mjs",
    "remotion:render-demo": "node scripts/remotion-demo.mjs",
    "prestart": "npm run remotion:prepare"
  },
  "dependencies": {
    "three": "0.180.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "sharp": "0.35.5",
    "ffmpeg-static": "5.3.0",
    "@derhuerst/ffprobe-static": "5.3.0",
    "fflate": "0.8.3",
    "remotion": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/bundler": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "esbuild": "0.25.12"
  }
}
